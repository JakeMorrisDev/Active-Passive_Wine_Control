sudo systemctl status winecooling winedash      # check status
journalctl -u winecooling -f                    # follow cooling logs
journalctl -u winedash -f                       # follow dashboard logs
sudo systemctl restart winecooling               # restart after editing the script
sudo systemctl stop winecooling winedash         # stop both
sudo sudo systemctl restart netcheck.timer              # restart netcheck timer this automatically sarts the service

# check enabled status
systemctl is-enabled winecooling
systemctl is-enabled winedash
systemctl is-enabled netcheck.timer